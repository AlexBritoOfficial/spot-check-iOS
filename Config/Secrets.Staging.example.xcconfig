// Copy this file to Config/Secrets.Staging.xcconfig (gitignored) once
// the hosted `spot-check-staging` Supabase project exists. Never commit
// Secrets.Staging.xcconfig.
//
// Gotcha: "//" starts a COMMENT in xcconfig files. A value containing
// "https://..." silently truncates at the slashes — that's why this is
// split into SCHEME + HOST instead of one full URL.

SUPABASE_SCHEME = https
SUPABASE_HOST = your-staging-project-ref.supabase.co
SUPABASE_ANON_KEY = your-staging-publishable-or-anon-key
