// Copy this file to Config/Secrets.QA.xcconfig (gitignored) once the
// hosted `spot-check-test` Supabase project exists. Never commit
// Secrets.QA.xcconfig.
//
// Gotcha: "//" starts a COMMENT in xcconfig files. A value containing
// "https://..." silently truncates at the slashes — that's why this is
// split into SCHEME + HOST instead of one full URL.

SUPABASE_SCHEME = https
SUPABASE_HOST = your-test-qa-project-ref.supabase.co
SUPABASE_ANON_KEY = your-test-qa-publishable-or-anon-key
