// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in real
// values. Never commit Secrets.xcconfig.
//
// Gotcha: "//" starts a COMMENT in xcconfig files. A value containing
// "https://..." silently truncates at the slashes. That's why this is
// split into SCHEME + HOST instead of one full URL — AppEnvironment
// reassembles them in code.

// --- Hosted Supabase project (production/staging) ---
SUPABASE_SCHEME = https
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-publishable-or-anon-key

// --- Local `supabase start` stack (uncomment to point the app at it) ---
// SUPABASE_SCHEME = http
// SUPABASE_HOST = 127.0.0.1:54321
// SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
