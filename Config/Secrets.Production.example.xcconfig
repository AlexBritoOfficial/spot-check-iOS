// Copy this file to Config/Secrets.Production.xcconfig (gitignored) once
// the hosted `spot-check-production` Supabase project exists. Never
// commit Secrets.Production.xcconfig.
//
// Gotcha: "//" starts a COMMENT in xcconfig files. A value containing
// "https://..." silently truncates at the slashes — that's why this is
// split into SCHEME + HOST instead of one full URL.

SUPABASE_SCHEME = https
SUPABASE_HOST = your-production-project-ref.supabase.co
SUPABASE_ANON_KEY = your-production-publishable-or-anon-key
