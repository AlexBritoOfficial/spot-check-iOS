<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Spot Check</string>
	<key>CFBundleDisplayName</key>
	<string>Spot Check</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<!-- Supabase project config — read by AppEnvironment at runtime.
	     Values come from Config/Secrets.xcconfig via Xcode's standard
	     $(VAR) Info.plist substitution; never hardcode real values here. -->
	<key>SUPABASE_SCHEME</key>
	<string>$(SUPABASE_SCHEME)</string>
	<key>SUPABASE_HOST</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>

	<!-- Google OAuth callback -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.spotcheck.ios.auth-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Spot Check uses your location to show nearby skate spots and center the map on where you are.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Spot Check needs access to your photo library so you can add a photo when submitting a spot.</string>
	<key>NSCameraUsageDescription</key>
	<string>Spot Check needs camera access so you can take a photo when submitting a spot.</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- The design canvas has no light-mode variant across any of the 19
	     screens -- it's a fixed dark theme, not a system-adaptive one. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>UIAppFonts</key>
	<array>
		<string>ArchivoBlack-Regular.ttf</string>
	</array>
</dict>
</plist>
